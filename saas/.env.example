# ── Database ───────────────────────────────────────────────
POSTGRES_DB=carscan
POSTGRES_USER=carscan
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Set automatically by docker-compose — don't change:
# DATABASE_URL=postgresql+asyncpg://carscan:CHANGE_ME@db:5432/carscan

# ── Auth ───────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_hex_chars

# ── Stripe ─────────────────────────────────────────────────
# 1. Create account at stripe.com
# 2. Create a Product "CarScan IDF" + recurring Price €5/month
# 3. Copy the keys below from stripe.com/dashboard/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# 4. Add webhook endpoint in Stripe Dashboard:
#    URL: https://yourdomain.com/stripe/webhook
#    Events to listen:
#      - checkout.session.completed
#      - customer.subscription.updated
#      - customer.subscription.deleted

# ── App ────────────────────────────────────────────────────
APP_URL=https://yourdomain.com

# ── Video Pipeline (Marcel) ────────────────────────────────
# Stage 2 – Script generation (Anthropic Claude)
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Stage 3 – Voice generation (ElevenLabs)
# Sign up at elevenlabs.io  |  Free: 10K chars/month  |  Starter $5: 30K chars
# Creator $22/month gives 100K chars — recommended for daily publishing.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Voice ID for Marcel (deep, sophisticated European French male voice).
# Recommended: search ElevenLabs Voice Library for "Luc" or "Xavier" (French).
# Default fallback is "Adam" (multilingual) — replace with a French voice ID.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Stage 4 – Video assembly (Shotstack)
# Sign up at shotstack.io  |  Sandbox = free + watermark  |  Dev $49/mo = 250 renders
# Use "stage" for sandbox (watermarked), "v1" for production.
SHOTSTACK_API_KEY=your_shotstack_api_key
SHOTSTACK_STAGE=v1

# Optional: public URL of your Autoradar logo image (PNG/SVG, transparent bg).
# If not set, a text card is used as the outro.
AUTORADAR_LOGO_URL=

# Local directories for generated assets (must be writable by the app).
VIDEO_AUDIO_DIR=/tmp/autoradar/audio
VIDEO_OUTPUT_DIR=/tmp/autoradar/video
